{
  "name": "nasj-skills-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "NASJ (نَسْج): multi-role skills, assessment, evidence and talent discovery platform. Front-end demo.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/styles.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./src/styles.css -o ./css/styles.css --watch",
    "start": "http-server . -p 3000 -a 0.0.0.0 -c-1 --silent",
    "dev": "npm run build:css && npm run start",
    "build": "npm run build:css && node scripts/build.mjs"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "tailwindcss": "3.4.17"
  }
}
